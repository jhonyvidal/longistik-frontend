## -----------------------------------------
## Versión de la app (opcional, se muestra en el pie)
## -----------------------------------------
NEXT_PUBLIC_VERSION=

## -----------------------------------------
## URL pública del sitio
## -----------------------------------------
NEXT_PUBLIC_PATH=
# Prefijo cuando el sitio no se sirve en la raíz del dominio
NEXT_PUBLIC_BASE_NAME=

## -----------------------------------------
## SEO — dominio usado para las URLs canónicas y las imágenes de Open Graph
## Ej. https://www.longistik.com
## -----------------------------------------
NEXT_PUBLIC_METADATA_BASE=

## -----------------------------------------
## Google Analytics (opcional). Sin este valor no se carga ningún script de terceros.
## -----------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=

## -----------------------------------------
## Solicitudes de demo → backend del panel de Longistik (guarda el lead y envía los correos)
## Si DEMO_API_URL se deja vacía, las solicitudes solo quedan en los logs del servidor.
## Sin prefijo NEXT_PUBLIC_: solo se leen en el servidor, nunca llegan al navegador.
## -----------------------------------------
DEMO_API_URL=https://api.panel.longistik.com/api/public/demo-requests
# Debe coincidir con el setting demo_api_key del panel (Configuración).
DEMO_API_KEY=

## -----------------------------------------
## Verificación de buscadores (opcional). Se copian del panel de cada uno.
## Google Search Console → Configuración → Verificación de la propiedad → Etiqueta HTML (solo el content)
## Bing Webmaster Tools  → Agregar sitio → Metaetiqueta HTML (msvalidate.01, solo el content)
## -----------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

## -----------------------------------------
## IndexNow (opcional): avisa a Bing y otros buscadores cuando se publica contenido.
## Cualquier cadena de 8 a 128 caracteres (letras, números y guiones). Se sirve en /indexnow.txt.
## Después de publicar: node scripts/indexnow.mjs
## -----------------------------------------
INDEXNOW_KEY=
